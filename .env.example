# MessagingMatrix v6 environment variables.
# See docs/REBUILD_SPEC.md §11 + §17 for the full list.

# Required: which client this deploy serves. Must match clients.key in DB.
# On first boot, the row is auto-created with default lookAndFeel.
#
# Port mapping (locked):
#   demo     → 6000  (npm run dev:demo)
#   erste    → 6001  (npm run dev:erste, also `npm run dev`)
#   telekom  → 6002  (npm run dev:telekom)
#   proficio → 6003  (npm run dev:proficio)
ACTIVE_CLIENT_KEY=erste

# Required: JWT signing secret. Generate with: openssl rand -hex 32
JWT_SECRET=

# Required: per-deploy MCP bearer (separate from clients.mcp_token).
# Acts as a kill-switch — unset to disable /mcp on this deploy.
MCP_BEARER_TOKEN=

# Optional: SQLite path. Default ./db/matrix.db
DATABASE_URL=file:./db/matrix.db

# Optional: storage root for uploaded files
STORAGE_ROOT=./storage

# Optional: Next.js port
PORT=3000

# AdForm (optional — XLSX path or live API)
ADFORM_REPORT_PATH=
ADFORM_CLIENT_ID=
ADFORM_CLIENT_SECRET=
ADFORM_TOKEN_URL=
ADFORM_API_BASE=
ADFORM_SCOPE=

# Google service account JSON (single-line) for one-shot Sheets export/import.
GOOGLE_SERVICE_ACCOUNT_JSON=
